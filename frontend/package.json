{
  "name": "zhixing-quiz-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "知行快刷｜AI 知识库自测与智能闯关微信小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:weapp:local": "NODE_ENV=development taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "NODE_ENV=development taro build --type weapp --watch",
    "dev:h5": "NODE_ENV=development taro build --type h5 --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src config test",
    "check:all": "pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/preset-react": "^7.28.5",
    "@tarojs/components": "4.1.11",
    "@tarojs/helper": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/react": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.21.5",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "4.1.11",
    "@tarojs/webpack5-runner": "4.1.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-preset-taro": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.80.0",
    "typescript": "^5.1.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7",
    "webpack": "5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "core-js",
      "core-js-pure",
      "esbuild"
    ],
    "overrides": {
      "lodash-es@<4.18.0": "^4.18.1",
      "swiper@<12.1.2": "^12.1.2"
    }
  }
}
