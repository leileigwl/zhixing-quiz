# 知行快刷（ZhiXing Quiz）后端环境变量模板
# 复制本文件为 .env 后按实际环境填写；生产环境请务必设置强 JWT_SECRET 与 APP_ENV=production

# 运行环境: development | test | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# JWT 安全配置（APP_ENV=production 时必须为 >=32 位随机强密钥，否则拒绝启动）
JWT_SECRET=dev-only-insecure-secret-change-in-production
JWT_EXPIRE_MINUTES=43200
# 仅非生产环境用于 H5/本地联调；production 下强制禁止生效
ALLOW_DEV_LOGIN=true

# 对话大模型配置（通用 LLM_* 优先；留空时回退读取 DEEPSEEK_*，兼容硅基流动 / DeepSeek 官方）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily 联网搜索配置（可选；无 Key 时自动跳过搜索平滑降级）
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=true

# 文本向量化 Embedding（通用 EMBEDDING_* 优先；留空时回退读取 DASHSCOPE_*）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 知识库与 Chroma 本地持久化
CHROMA_PERSIST_DIR=./data/chroma
KB_UPLOAD_DIR=./data/uploads
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4

# 限流与超时保护
QUIZ_RATE_LIMIT_PER_MINUTE=5
QUIZ_TASK_TIMEOUT_SECONDS=180

# 题目 AI 配图（DashScope 千问文生图）
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=
IMAGE_GEN_SIZE=512*512
IMAGE_GEN_DAILY_LIMIT=20
IMAGE_GEN_MAX_CONCURRENCY=5

# 腾讯云 COS（未配置且 ALLOW_LOCAL_IMAGE_FALLBACK=true 时自动保存到本地静态目录）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_UPLOAD_PREFIX=quiz-images/
COS_DOMAIN=
ALLOW_LOCAL_IMAGE_FALLBACK=true
LOCAL_IMAGE_DIR=./data/static/quiz-images

# 微信小程序（个人免费版 / 测试号 AppID 与 Secret）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# MySQL 8.0 连接配置（配合根目录下 docker-compose.yml 使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=zhixing_dev_pass
MYSQL_DATABASE=zhixing_quiz
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=true
